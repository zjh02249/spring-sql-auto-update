<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cbkj.infrastructure</groupId>
    <artifactId>flyway-digital</artifactId>
    <version>1.3.6.1</version>
    <packaging>pom</packaging>

    <name>Flyway Digital - Lightweight SQL Migration Tool</name>
    <description>A lightweight, Flyway-compatible SQL migration tool</description>

    <properties>
        <!-- 缂栬瘧閰嶇疆 -->
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 鐗堟湰鍙风鐞?-->
        <spring-boot.version>2.7.18</spring-boot.version>
        <slf4j.version>1.7.36</slf4j.version>
        <junit.version>4.13.2</junit.version>
        <h2.version>2.2.224</h2.version>
        <mysql-connector.version>8.0.33</mysql-connector.version>

        <!-- 鎻掍欢鐗堟湰 -->
        <maven-compiler-plugin.version>3.11.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.1.2</maven-surefire-plugin.version>
        <jacoco.version>0.8.11</jacoco.version>
    </properties>

    <!--
        ============================================
        妯″潡鍒嗙被璇存槑锛堥儴缃茶鑼冿級
        ============================================
        
        銆愭牳蹇冩ā鍧?- 闇€瑕佸彂甯冨埌 Maven 浠撳簱銆?        杩欎簺妯″潡浼氳鍏朵粬椤圭洰渚濊禆锛屽繀椤诲彂甯冨埌 Maven 浠撳簱
        - flyway-digital-core: 鏍稿績杩佺Щ寮曟搸
        - flyway-digital-spring-boot-starter: Spring Boot 鑷姩閰嶇疆 Starter
        
        銆愮ず渚嬫ā鍧?- 涓嶉渶瑕佸彂甯冨埌 Maven 浠撳簱銆?        杩欎簺妯″潡浠呯敤浜庢紨绀猴紝宸查厤缃?maven.deploy.skip=true
        閮ㄧ讲鏃朵細鑷姩璺宠繃锛屼笉鍙戝竷鍒?Maven 浠撳簱
        - flyway-digital-samples (鑱氬悎妯″潡)
          - spring-boot-sample: Spring Boot 闆嗘垚绀轰緥
          - standalone-sample: 鐙珛浣跨敤绀轰緥
        
        銆愬彂甯冨懡浠ゃ€?        鎺ㄨ崘鍙彂甯冩牳蹇冩ā鍧楋細
        mvn clean deploy -DskipTests \
            -pl flyway-digital-core,flyway-digital-spring-boot-starter \
            -am
        
        璇︾粏璇存槑璇峰弬鑰?BUILD_AND_DEPLOY.md
        ============================================
    -->
    <modules>
        <!-- 鏍稿績妯″潡锛堥渶瑕佸彂甯冨埌 Maven 浠撳簱锛?-->
        <module>flyway-digital-core</module>
        <module>flyway-digital-spring-boot-starter</module>
        
        <!-- 绀轰緥妯″潡锛堜笉闇€瑕佸彂甯冨埌 Maven 浠撳簱锛?-->
        <module>flyway-digital-samples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- 鍐呴儴妯″潡 -->
            <dependency>
                <groupId>com.cbkj.infrastructure</groupId>
                <artifactId>flyway-digital-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cbkj.infrastructure</groupId>
                <artifactId>flyway-digital-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring Boot (optional, for compatibility) -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- SLF4J -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <!-- 娴嬭瘯渚濊禆 -->
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <!-- Jacoco 浠ｇ爜瑕嗙洊鐜?-->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>CLASS</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.70</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- 绉佹湁 Maven 浠撳簱閰嶇疆 - 鍙戝竷鐩爣浠撳簱 -->
    <distributionManagement>
        <repository>
            <id>maven-releases</id>
            <name>TCM Brain Maven Releases</name>
            <url>http://maven.tcmbrain.cn/repository/maven-releases/</url>
        </repository>
    </distributionManagement>

</project>
