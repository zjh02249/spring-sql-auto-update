<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cbkj.infrastructure</groupId>
        <artifactId>flyway-digital</artifactId>
        <version>1.3.6.1</version>
    </parent>

    <artifactId>flyway-digital-core</artifactId>
    <packaging>jar</packaging>

    <name>Flyway Digital Core</name>
    <description>Core migration engine for Flyway Digital</description>

    <dependencies>
        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- 娴嬭瘯渚濊禆 -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MySQL JDBC 驱动 (测试用) -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>5.1.49</version>
            <scope>test</scope>
        </dependency>
        <!-- PostgreSQL JDBC 鎬动 (测试用) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.5.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>process-resources</phase>
                        <configuration>
                            <target>
                                <!-- 娓呯悊宸插瓨鍦ㄧ殑 migration.index -->
                                <delete file="${project.build.outputDirectory}/db/migration/migration.index" failonerror="false"/>
                                <!-- 鍒涘缓鐩爣鐩綍 -->
                                <mkdir dir="${project.build.outputDirectory}/db/migration"/>
                                <!-- 鎵弿 SQL 鏂囦欢骞剁敓鎴愮储寮?-->
                                <pathconvert property="migration.files" pathsep="&#10;">
                                    <fileset dir="${project.basedir}/src/main/resources/db/migration" erroronmissingdir="false">
                                        <include name="V*.sql"/>
                                    </fileset>
                                    <mapper type="flatten"/>
                                </pathconvert>
                                <!-- 鍐欏叆 migration.index -->
                                <echo file="${project.build.outputDirectory}/db/migration/migration.index">${migration.files}</echo>
                                <!-- 杈撳嚭璋冭瘯淇℃伅 -->
                                <echo message="Generated migration.index with files: ${migration.files}"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Jacoco 浠ｇ爜瑕嗙洊鐜?-->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>perf-benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <configuration>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
